{
  "name": "nova",
  "private": true,
  "version": "0.1.0",
  "description": "NOVA - offline-first, on-device personal learning twin (Code Carnival 3.0, PS-06)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run test && npm run validate:content",
    "check:offline": "tsx scripts/check-offline-build.ts",
    "evidence": "tsx scripts/run-evidence.ts",
    "verify:content": "tsx scripts/verify-content.ts",
    "content:review": "tsx scripts/export-content-review.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
